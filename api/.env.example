# Développement local — ne jamais committer de vraies clés
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/folio
APP_NAME=Folio
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=300
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_RETURN_URL=folio://checkout/return
ORDER_PENDING_TTL_MINUTES=60
MAIL_DRIVER=console
MAIL_FROM="Folio <no-reply@folio.local>"
SMTP_URL=
DEMO_PRICE_CENTS=100
SEED_ADMIN_EMAIL=admin@folio.local
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=client@folio.local
SEED_CUSTOMER_PASSWORD=
