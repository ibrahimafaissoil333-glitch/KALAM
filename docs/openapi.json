  "info": {
    "title": "API Folio",
    "description": "Vente et lecture d'e-books — application mobile et administration. Toutes les routes sont préfixées par /v1.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "deviceKey": {
            "type": "string",
            "description": "Identifiant stable de l'appareil (généré par l'app)"
          },
          "deviceLabel": {
            "type": "string",
            "example": "iPhone de Sarah"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "name": {
            "type": "string",
            "example": "Sarah"
          },
          "email": {
            "type": "string",
            "example": "sarah@exemple.fr"
          },
          "password": {
            "type": "string",
            "description": "Le mot de passe doit contenir au moins 8 caractères, dont une lettre et un chiffre."
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Acceptation des CGU et de la politique de confidentialité (obligatoire)"
          },
          "marketingConsent": {
            "type": "boolean",
            "description": "Consentement aux e-mails de nouveautés (facultatif)"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "acceptTerms"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "deviceKey": {
            "type": "string",
            "description": "Identifiant stable de l'appareil (généré par l'app)"
          },
          "deviceLabel": {
            "type": "string",
            "example": "iPhone de Sarah"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "Le mot de passe doit contenir au moins 8 caractères, dont une lettre et un chiffre."
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "AddItemDto": {
        "type": "object",
        "properties": {
          "ebookId": {
            "type": "string"
          }
        },
        "required": [
          "ebookId"
        ]
      },
      "MergeDto": {
        "type": "object",
        "properties": {
          "ebookIds": {
            "description": "Identifiants du panier invité conservé sur l'appareil",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ebookIds"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "ebookIds": {
            "description": "Par défaut : le contenu du panier",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "returnUrl": {
            "type": "string",
            "description": "Adresse de retour de l'app après paiement (préfixes autorisés : CHECKOUT_RETURN_PREFIXES)"
          }
        }
      },
      "ProgressDto": {
        "type": "object",
        "properties": {
          "chapterIndex": {
            "type": "number"
          },
          "blockIndex": {
            "type": "number"
          },
          "percent": {
            "type": "number"
          }
        },
        "required": [
          "chapterIndex",
          "blockIndex",
          "percent"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "NotificationsDto": {
        "type": "object",
        "properties": {
          "ebookUpdates": {
            "type": "boolean",
            "description": "Mises à jour d'e-books déjà achetés"
          },
          "marketing": {
            "type": "boolean",
            "description": "Nouveautés et offres (consentement)"
          }
        },
        "required": [
          "ebookUpdates",
          "marketing"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "CreateEbookDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Nom de catégorie (créée si absente)"
          },
          "priceCents": {
            "type": "object",
            "description": "Prix TTC en centimes ; vide = prix à définir (non publiable)",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "format": {
            "type": "string"
          },
          "pages": {
            "type": "object"
          },
          "downloadAllowed": {
            "type": "boolean"
          },
          "previewBlocks": {
            "type": "number",
            "description": "Nombre de blocs de texte de l'extrait gratuit"
          },
          "featured": {
            "type": "boolean"
          },
          "coverBg": {
            "type": "string"
          },
          "coverFg": {
            "type": "string"
          },
          "coverTint": {
            "type": "string"
          }
        }
      },
      "EbookDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Nom de catégorie (créée si absente)"
          },
          "priceCents": {
            "type": "object",
            "description": "Prix TTC en centimes ; vide = prix à définir (non publiable)",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "format": {
            "type": "string"
          },
          "pages": {
            "type": "object"
          },
          "downloadAllowed": {
            "type": "boolean"
          },
          "previewBlocks": {
            "type": "number",
            "description": "Nombre de blocs de texte de l'extrait gratuit"
          },
          "featured": {
            "type": "boolean"
          },
          "coverBg": {
            "type": "string"
          },
          "coverFg": {
            "type": "string"
          },
          "coverTint": {
            "type": "string"
          }
        }
      },
      "UserStatusDto": {
        "type": "object",
        "properties": {}
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "appName": {
            "type": "string"
          },
          "checkoutMode": {
            "type": "object"
          },
          "webCheckoutUrl": {
            "type": "object",
            "nullable": true
          },
          "maxDevices": {
            "type": "object",
            "nullable": true
          },
          "maxDownloadsPerBook": {
            "type": "object",
            "nullable": true
          },
          "supportEmail": {
            "type": "object",
            "nullable": true
          },
          "termsUrl": {
            "type": "object",
            "nullable": true
          },
          "salesTermsUrl": {
            "type": "object",
            "nullable": true
          },
          "privacyUrl": {
            "type": "object",
            "nullable": true
          },
          "legalNoticeUrl": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  }
}
